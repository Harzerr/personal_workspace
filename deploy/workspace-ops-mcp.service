[Unit]
Description=Personal AI Workspace read-only operations MCP
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker adm systemd-journal
WorkingDirectory=/srv/ai-agent-study/deploy
Environment=PYTHONUNBUFFERED=1
Environment=WORKSPACE_OPS_TARGETS_FILE=/srv/ai-agent-study/deploy/workspace-ops-targets.json
ExecStart=/srv/chatbot/.venv/bin/python /srv/ai-agent-study/deploy/workspace_ops_mcp_server.py --host 127.0.0.1 --port 7862
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ai-agent-study/deploy/workspace-ops-targets.json /proc

[Install]
WantedBy=multi-user.target
